# NovaFlix Frontend Environment Variables
# Copy this to .env.local and fill in your values

# API Base URL
VITE_API_BASE=http://localhost:3030/api

# Persona KYC (get from Persona Dashboard)
VITE_PERSONA_TEMPLATE_ID=itmpl_xxxxx
VITE_PERSONA_ENV_ID=env_xxxxx

# App URL
VITE_APP_URL=http://localhost:3000

# Feature flags
VITE_ENABLE_PPM=true
VITE_ENABLE_WALLET=true
VITE_ENABLE_CLAIM_FLOW=true