{
  "name": "novaflix",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c red,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w client",
    "build": "npm run build -w client"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@sendinblue/client": "^3.3.1",
    "debug": "^4.4.3",
    "depd": "^2.0.0",
    "flutterwave-node-v3": "^1.4.1",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pngjs": "^7.0.0"
  }
}
